# Copy privately to /etc/youpi/gpay-observer.env, readable only by the service user.
NODE_ENV=production
BASE_PAYMENT_API_URL=http://127.0.0.1:6100
GPAY_TRANSACTIONS_URL=
GPAY_RECEIVING_ACCOUNT_ID=
GPAY_PAYEE_VPA=7449787234@okbizaxis
OBSERVER_API_TOKEN=
GPAY_CHANNEL=chromium
GPAY_HEADLESS=true
GPAY_POLL_SECONDS=60
GPAY_MAX_PAGES=10
GPAY_LOOKBACK_HOURS=48
GPAY_PROFILE_DIR=/opt/youpi-pg/data/browser-sessions/gpay
GPAY_OBSERVER_DB_PATH=/opt/youpi-pg/data/gpay-observer.sqlite
GPAY_HEALTH_PATH=/opt/youpi-pg/data/gpay-observer-health.json
PLAYWRIGHT_BROWSERS_PATH=/opt/youpi-pg/data/browsers
