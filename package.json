{
  "name": "youpi-pg",
  "version": "1.0.0",
  "type": "module",
  "description": "Self-Hosted White-Label UPI Payment Gateway with Payment Observation Engine",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node scripts/clean.js",
    "db:setup": "node scripts/init-db.cjs",
    "sync:package": "node scripts/sync-package.cjs",
    "start": "node scripts/start.js",
    "start:prod": "node scripts/start.js",
    "start:prod:api": "node apps/payment-api/src/index.js",
    "dev": "node scripts/dev.js",
    "test": "node scripts/test-all.js",
    "test:all": "node scripts/test-all.js",
    "test:acceptance": "node --test scripts/production-infrastructure.test.js",
    "typecheck": "tsc -b --noEmit",
    "gpay:login": "node --env-file-if-exists=.env apps/gpay-observer/src/index.js --login",
    "gpay:worker": "node --env-file-if-exists=.env apps/gpay-observer/src/index.js",
    "gpay:once": "node --env-file-if-exists=.env apps/gpay-observer/src/index.js --once",
    "test:gpay": "node --test apps/gpay-observer/src/__tests__/*.test.js apps/payment-api/src/__tests__/gpay-receipts.test.js",
    "test:gpay:browser": "node --test apps/gpay-observer/test-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "Antigravity Systems",
  "license": "Commercial"
}
